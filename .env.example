# EVE SSO application credentials from https://developers.eveonline.com
# Register an app with callback URL matching ESI_CALLBACK_URL below.
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=

# Must match the callback URL registered on the EVE developers portal
# byte-for-byte (scheme, host, port, path; localhost != 127.0.0.1).
ESI_CALLBACK_URL=http://localhost:8000/auth/eve/callback

# Space-separated OAuth scopes requested at authorization time. The app on the
# developer portal must declare all of these (requested scopes must be a
# subset of registered scopes or SSO rejects the authorization). Changing the
# list later requires users to re-authorize.
ESI_SCOPES=publicData esi-skills.read_skills.v1 esi-wallet.read_character_wallet.v1 esi-wallet.read_corporation_wallet.v1 esi-assets.read_assets.v1 esi-industry.read_character_jobs.v1 esi-markets.read_character_orders.v1 esi-characters.read_blueprints.v1 esi-wallet.read_corporation_wallets.v1 esi-assets.read_corporation_assets.v1 esi-corporations.read_blueprints.v1 esi-industry.read_corporation_jobs.v1 esi-markets.read_corporation_orders.v1 esi-corporations.read_projects.v1

# Cookie/session signing key. Generate with: openssl rand -hex 32
SECRET_KEY=

# Public base URL of this app (no trailing slash). Controls cookie security
# and could be used for absolute links later.
BASE_URL=http://localhost:8000

# SQLAlchemy async URL. Default: SQLite file next to the repo root.
# Docker maps this to /data/industry.db via a named/bound volume.
DATABASE_URL=sqlite+aiosqlite:///./industry.db
